// use prisma-8

model User {
  id        Int                @id @default(autoincrement())
  email     String             @unique
  password  String
  name      String
  transections Transaction[]
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Transaction {
  id  Int                @id @default(autoincrement())
  user_id Int
  user User @relation(fields: [user_id], references: [id])     
  title String
  amount Decimal 
  category String
  createdAt DateTime           @default(now()) @onCreate(now())
}

